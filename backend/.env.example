# ==============================================================================
# CareerPilot AI - Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting the backend server.
#
# Development defaults connect to local MongoDB.
# In production, replace placeholders with verified cloud credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Environment
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# 2. Database Connection
# ------------------------------------------------------------------------------
# Local development:
MONGO_URI=mongodb://127.0.0.1:27017/careerpilot_ai
# Production (MongoDB Atlas cluster):
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/careerpilot_ai?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 3. Security & JWT Authentication
# ------------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
JWT_SECRET=your_super_secret_production_key_minimum_32_characters
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 4. Google Gemini AI API
# ------------------------------------------------------------------------------
# Get your API key from Google AI Studio (https://aistudio.google.com/)
# Fallback heuristic analysis is active if omitted.
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 5. Cloudinary Cloud Storage
# ------------------------------------------------------------------------------
# Create account at https://cloudinary.com/ for cloud resume document storage.
# Fallback local disk storage is active in /uploads if omitted.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ------------------------------------------------------------------------------
# 6. Nodemailer Email Dispatch (Interview Invitations & Alerts)
# ------------------------------------------------------------------------------
# Gmail SMTP or transactional service (SendGrid, Mailgun, Amazon SES).
# For Gmail, generate an App Password from Google Account Security.
# Simulated console delivery is active if omitted.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
