# ==============================================================================
# CareerPilot AI - Full-Stack Root Environment Configuration
# ==============================================================================

# Backend Server & Runtime
PORT=5000
NODE_ENV=production
CLIENT_URL=http://localhost:5173

# Database (MongoDB connection string)
MONGO_URI=mongodb://127.0.0.1:27017/careerpilot_ai

# Security
JWT_SECRET=production_docker_jwt_secret_careerpilot_ai
JWT_EXPIRES_IN=7d

# Google Gemini API
GEMINI_API_KEY=

# Cloudinary Cloud Storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email Dispatch Gateway
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=

# Frontend Environment Variables
VITE_API_BASE_URL=/api
